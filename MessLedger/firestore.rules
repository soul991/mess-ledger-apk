rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isMember(messId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/messes/$(messId)/members/$(request.auth.uid)) &&
        (!('deletedAt' in get(/databases/$(database)/documents/messes/$(messId)/members/$(request.auth.uid)).data) ||
         get(/databases/$(database)/documents/messes/$(messId)/members/$(request.auth.uid)).data.deletedAt == null);
    }
    function isManager(messId) {
      return isMember(messId) &&
        get(/databases/$(database)/documents/messes/$(messId)/members/$(request.auth.uid)).data.role == 'manager';
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /usernames/{username} {
      allow create: if request.auth != null;
      allow read: if true;
      allow update, delete: if false;
    }

    match /messes/{messId} {
      // A mess ID is 8 characters from a ~35-character alphabet (~2.4 trillion
      // combinations) — not practically guessable — so any authenticated user reading
      // the mess doc itself (messName/categories only) is fine, and is required for a
      // first-time join requester to confirm the mess exists before submitting a
      // request. list stays disabled; every subcollection still requires real
      // membership — this line only ever exposes the mess's name/category list.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isManager(messId);

      match /members/{memberId} {
        allow read: if isMember(messId);
        // Two ways a member doc gets created: (a) the manager approves a join request, or
        // (b) the mess creator writes their own manager row in the same batch as creating
        // the mess itself — at that instant isManager() is false (no member doc exists yet),
        // so it's gated on being the mess's createdBy instead, and only for a manager role.
        allow create: if isManager(messId) ||
          (request.auth.uid == memberId && request.resource.data.role == 'manager' &&
           get(/databases/$(database)/documents/messes/$(messId)).data.createdBy == request.auth.uid);
        // Self-edits (e.g. your own display name) are fine; changing role — your own or
        // anyone else's — requires already being the manager, otherwise any member could
        // write role:"manager" to their own doc and self-promote.
        allow update: if isManager(messId) ||
          (request.auth.uid == memberId && request.resource.data.role == resource.data.role);
        allow delete: if isManager(messId);
      }

      match /meals/{dateStr} {
        allow read, write: if isMember(messId);
      }

      match /expenses/{expenseId} {
        allow read, write: if isMember(messId);
      }

      match /contributions/{contribId} {
        allow read, write: if isMember(messId);
      }

      match /guestMeals/{guestMealId} {
        allow read, write: if isMember(messId);
      }

      match /joinRequests/{uid} {
        // Belt-and-suspenders alongside the app-level existence check in RequestRepository:
        // without this, Firestore will happily create this doc under a messId that doesn't
        // correspond to any real mess, which is how "request sent" with nothing on the other
        // end happens — a client bug, a stale/typo'd ID, or a bypass of the app entirely.
        allow create: if request.auth != null && request.auth.uid == uid &&
          exists(/databases/$(database)/documents/messes/$(messId));
        allow read: if isManager(messId) || request.auth.uid == uid;
        allow update, delete: if isManager(messId) || request.auth.uid == uid;
      }

      match /leaveRequests/{uid} {
        allow create: if request.auth != null && request.auth.uid == uid && isMember(messId);
        allow read: if isManager(messId) || request.auth.uid == uid;
        allow update, delete: if isManager(messId) || request.auth.uid == uid;
      }

      match /activityLog/{entryId} {
        allow read: if isMember(messId);
        allow write: if false;
      }
    }
  }
}
